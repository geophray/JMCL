<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Local folder feed for JMCL packages during development. Created by
      "dotnet pack -o local-feed" from the repository root. Gitignored.
    -->
    <add key="local" value="local-feed" />
  </packageSources>
</configuration>
