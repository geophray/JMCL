<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net462 only: the generator targets the plugin framework, like the tool it drives. -->
    <TargetFrameworks>$(PluginTargetFramework)</TargetFrameworks>
    <RootNamespace>JMCL.Dataverse.ProxyGenerator.Tests</RootNamespace>
    <AssemblyName>JMCL.Dataverse.ProxyGenerator.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\JMCL.Dataverse.ProxyGenerator\JMCL.Dataverse.ProxyGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The template the ProxyBuilder package ships, so the test exercises exactly what consumers get. -->
    <None Include="..\..\tools\JMCL.Dataverse.ProxyGenerator.Cmd\Package\ProxyTemplate.t4" Link="ProxyTemplate.t4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
