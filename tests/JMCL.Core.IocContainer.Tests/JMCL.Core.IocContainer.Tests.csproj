<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 runs on any machine. net462 exercises the framework the plugin
      sandbox actually loads, but can only be executed on Windows, so CI runs it.
      Locally on macOS or Linux use: dotnet test -f net8.0
    -->
    <TargetFrameworks>$(PluginTargetFramework);$(PortableTargetFramework)</TargetFrameworks>
    <RootNamespace>JMCL.Core.Tests</RootNamespace>
    <AssemblyName>JMCL.Core.IocContainer.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JMCL.Core.IocContainer\JMCL.Core.IocContainer.csproj" />
  </ItemGroup>

</Project>
