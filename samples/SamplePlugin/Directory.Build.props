<Project>
  <!-- Isolated from the repository build on purpose: this must behave like an
       outside consumer of the published packages, not like an in-repo project. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!--
      The JMCL version under test. Versions come from git tags via MinVer, so
      hardcoding one here guarantees a mismatch the moment the tag moves.
      build/verify.sh passes the real value; this default only keeps the project
      evaluatable when built by hand.
    -->
    <JmclVersion Condition="'$(JmclVersion)' == ''">0.0.0-alpha.0.1</JmclVersion>
  </PropertyGroup>
</Project>
